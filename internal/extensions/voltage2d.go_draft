package extensions

import (
	"cmp"
	"fmt"
	"math"
	"os"
	"slices"

	"github.com/wildstyl3r/stmc/internal/config"
	"github.com/wildstyl3r/stmc/internal/constants"
	"github.com/wildstyl3r/stmc/internal/model"
	"github.com/wildstyl3r/stmc/internal/utils"
)

func VoltageCalculation2D(configFlags config.Flags, parameters config.ModelParameters, outputDir string) (dataRow *Voltage2DDataRow, finalModel *model.Model) {
	if *configFlags.Verbose {
		fmt.Print("calculating dc iteratively:\n")
	}
	iteration := 1
	itp := &iteration
	minDc := parameters.CathodeFallLengthPrecision
	var maxDc float64
	if parameters.ParallelPlaneHollowCathode {
		maxDc = parameters.GapLength / 2
	} else {
		maxDc = parameters.GapLength
	}

	minV, maxV := 100., 1000.

	if *configFlags.Debug {
		vdr := bruteForceStepVoltageCalculation2D(minDc, maxDc, minV, maxV, configFlags, itp, parameters, outputDir)
		maxOverRows := make([]*Voltage2DDataRow, len(vdr))
		for i := range vdr {
			maxOverRows[i] = slices.MaxFunc(vdr[i], func(a, b *Voltage2DDataRow) int {
				return cmp.Compare(math.Abs(a.GammaLoss), math.Abs(b.GammaLoss))
			})
		}
		return slices.MaxFunc(maxOverRows, func(a, b *Voltage2DDataRow) int {
			return cmp.Compare(math.Abs(a.GammaLoss), math.Abs(b.GammaLoss))
		}), nil
	} else {
		return advancedVoltageCalculation2D(minDc, maxDc, minV, maxV, itp, parameters)
	}
}

type Voltage2DDataRow struct {
	OptimizationResult
	CathodeVoltage float64 `csv:"Voltage"`
	VoltageMargin  float64 `csv:"Voltage margin"`
}

func bruteForceStepVoltageCalculation2D(minDc, maxDc, minV, maxV float64, configFlags config.Flags, itp *int, parameters config.ModelParameters, outputDir string) (debugData [][]*Voltage2DDataRow) {
	dcStep := 0.00001
	VStep := 5.
	nXSteps := int((maxDc - minDc) / dcStep)
	nVSteps := int((maxV - minV) / VStep)
	fmt.Printf("GapLen: %f, nSteps: %d\n", parameters.GapLength, nXSteps)
	gamma := make([][]utils.Vec2D, nXSteps)
	debugData = make([][]*Voltage2DDataRow, nXSteps)
	for i := range nXSteps {
		gamma[i] = make([]utils.Vec2D, nVSteps)
		dc := float64(i)*dcStep + minDc
		for j := range nVSteps {
			V := float64(j)*VStep + minV
			var gammaLoss, gammaMargin utils.Vec2D
			gammaLoss, gamma[i][j], gammaMargin, _ = voltageCalculationStep2D(itp, V, dc, parameters)
			// voltageMargin := VoltageUncertaintyPropagation(dc, gammaMargin, parameters.CathodeFallPotential, parameters.GasDensity, utils.IonDriftVelocity[parameters.Species])
			debugData[i] = append(debugData[i], &Voltage2DDataRow{
				OptimizationResult: OptimizationResult{ReducedFieldAtCathode: 2 * parameters.CathodeFallPotential / (dc * parameters.GasDensity * constants.Townsend),
					ReducedFieldAtSheathCenter: parameters.CathodeFallPotential / (dc * parameters.GasDensity * constants.Townsend),
					CathodeFallLength:          dc,
					GammaLoss:                  (gammaLoss.X*gammaLoss.X + gammaLoss.Y*gammaLoss.Y) * 0.5,
				},
				CathodeVoltage: V,
				VoltageMargin:  voltageMargin,
			})
		}

	}
	gammaMean, gammaVariance := utils.MeanAndVariance(gamma, true)
	fmt.Printf("gamma mean: %.9f, gamma variance: %.9f\n", gammaMean, gammaVariance)

	err := utils.WriteAsCSV(debugData, outputDir, "debugVoltage")

	if err != nil {
		println("unable to save dc and voltage: ", err.Error())
		os.Exit(1)
	}
	return
}

func advancedVoltageCalculation2D(minDc, maxDc, minV, maxV float64, itp *int, parameters config.ModelParameters) (dataRow *Voltage2DDataRow, finalModel *model.Model) {
	var gammaLoss, gamma, gammaMargin utils.Vec2D
	gammaI := []utils.Vec2D{}
	fmt.Println("calculating voltage density with stochastic approximation")
	var fLeftLoss, fRightLoss, initialDc, initialV float64
	{
		var gILeft, gIRight float64
		fLeftLoss, gILeft, _, _ = voltageCalculationStep2D(nil, minV, minDc+parameters.CathodeFallLengthPrecision, parameters)
		fRightLoss, gIRight, _, _ = voltageCalculationStep2D(nil, maxV, maxDc-parameters.CathodeFallLengthPrecision, parameters)

		meanGI := 0.5 * (gILeft + gIRight)
		initialDc = getApproximateCathodeFallLengthForGamma(meanGI, minDc, maxDc, parameters)
	}
	approxLossDerivative := (fRightLoss - fLeftLoss) / (maxDc - minDc - 2*parameters.CathodeFallLengthPrecision)

	minSteps := 10
	initialTheta := utils.Vec2D{X: initialDc, Y: initialV}
	lowerBound := utils.Vec2D{X: minDc, Y: minV}
	upperBound := utils.Vec2D{X: maxDc, Y: maxV}
	precision := utils.Vec2D{X: parameters.CathodeFallLengthPrecision, Y: 0.1}
	theta, thetaMargin := utils.StochasticApproximation2D(lowerBound, upperBound, initialTheta, approxLossDerivative, precision, 0.95, minSteps, func(theta utils.Vec2D) utils.Vec2D {
		dc_inner, V_inner := theta.X, theta.Y
		gammaLoss, gamma, gammaMargin, finalModel = voltageCalculationStep2D(itp, V_inner, dc_inner, parameters)
		gammaI = append(gammaI, gamma)
		return gammaLoss
	})
	dc, V := theta.X, theta.Y
	dcMargin, VMargin := thetaMargin.X, thetaMargin.Y
	gamma = utils.Mean(gammaI[len(gammaI)-minSteps:])
	gammaMargin = max(gammaMargin, utils.StudentedMargin(0.95, gammaI[len(gammaI)-minSteps:]))
	gammaLoss = parameters.SecondaryEmissionCoefficient - gamma

	finalModel.Parameters.CathodeFallPotential = V

	println("saved d_c and j")
	return &Voltage2DDataRow{
		OptimizationResult: OptimizationResult{ReducedFieldAtCathode: 2 * parameters.CathodeFallPotential / (dc * parameters.GasDensity * constants.Townsend),
			ReducedFieldAtSheathCenter: parameters.CathodeFallPotential / (dc * parameters.GasDensity * constants.Townsend),
			CathodeFallLength:          dc,
			GammaLoss:                  (gammaLoss.X*gammaLoss.X + gammaLoss.Y*gammaLoss.Y) * 0.5,
		},
		CathodeVoltage: V,
		VoltageMargin:  VMargin,
	}, finalModel
}

func voltageCalculationStep2D(itp *int, V, dc float64, parameters config.ModelParameters) (loss, gammaEstimates, gammaMargins utils.Vec2D, stepModel *model.Model) {
	if itp != nil {
		fmt.Printf("step %d\n", *itp)
		*itp += 1
	} else {
		fmt.Println("preliminary step")
	}
	parameters.CathodeFallLength = dc
	parameters.CathodeFallPotential = V
	stepModel = (model.NewModel(parameters))
	LoadExtensions(stepModel.DataHub)
	stepModel.Run()
	gammaIntegral, _ := gammaIntegralF(stepModel)
	gammaAnalytic := gammaAnalyticF(dc, parameters.CathodeCurrentDensity, V, parameters.GasDensity, utils.IonDriftVelocity[parameters.Species])
	gammaEstimates = utils.Vec2D{
		X: gammaIntegral,
		Y: gammaAnalytic}
	loss = utils.Vec2D{X: parameters.SecondaryEmissionCoefficient - gammaEstimates.X, Y: parameters.SecondaryEmissionCoefficient - gammaEstimates.Y}
	if parameters.Verbose() {
		fmt.Printf("V: %v, d_c: %v\nsecondary emission coefficient\n\t integral: %6f\n\t target:%6f\n", V, dc, gammaEstimates, parameters.SecondaryEmissionCoefficient)
	}
	return
}
